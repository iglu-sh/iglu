{
    "responses": {
        "200": {
            "description": "Response containing the entire public key record (including the updated records)",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean", "enum": [false] },
                            "data": {
                                "type": "object",
                                "properties": {
                                    "id": { "type": "string" },
                                    "key": { "type": "string" },
                                    "api_keys_id": {
                                        "type": "object",
                                        "properties": {
                                            "id": { "type": "string" },
                                            "hash": { "type": "string" },
                                            "name": { "type": "string" }
                                        },
                                        "required": ["id", "hash", "name"]
                                    },
                                    "name": { "type": "string" }
                                },
                                "required": ["id", "key", "api_keys_id", "name"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "401": {
            "description": "The key you were using is not recognized",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
