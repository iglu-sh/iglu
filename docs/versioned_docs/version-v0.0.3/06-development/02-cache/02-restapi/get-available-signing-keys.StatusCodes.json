{
    "responses": {
        "200": {
            "description": "Response containing all signing keys associated with tenant",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean", "enum": [false] },
                            "data": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "string" },
                                        "key": { "type": "string" },
                                        "api_keys_id": {
                                            "type": "object",
                                            "properties": {
                                                "id": { "type": "string" },
                                                "hash": { "type": "string" },
                                                "name": { "type": "string" }
                                            },
                                            "required": ["id", "hash", "name"]
                                        },
                                        "name": { "type": "string" }
                                    },
                                    "required": ["id", "key", "api_keys_id", "name"]
                                }
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "401": {
            "description": "The key you were using is not recognized",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "403": {
            "description": "Forbidden - No authorization, either you didn't provide an authorization header or your header is not in the Bearer format",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "404": {
            "description": "The requested tenant does not exist on this server",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "503": {
            "description": "Returned if the feature this route is part of is not enabled",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        }
    }
}
