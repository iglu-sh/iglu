                                    "id",
                                    "github_username",
                                    "name",
                                    "permission",
                                    "is_public",
                                    "preferred_compression_method",
                                    "uri",
                                    "priority",
                                    "ttl"
                                ]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
