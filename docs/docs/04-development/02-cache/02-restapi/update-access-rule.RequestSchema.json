{
    "title": "Body",
    "body": {
        "description": "The new state the access rule should reflect",
        "required": true,
        "content": {
            "application/json": {
                "schema": {
                    "type": "object",
                    "properties": {
                        "ip_block": { "type": "string" },
                        "priority": { "type": "number" },
                        "action": { "type": "string", "enum": ["drop", "accept"] },
                        "name": { "type": "string" }
                    },
                    "required": ["ip_block", "priority", "action", "name"]
                }
            }
        }
    }
}
