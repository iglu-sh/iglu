{
    "responses": {
        "200": {
            "description": "Informational response if Iglu is running",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean", "enum": [false] },
                            "data": {
                                "type": "object",
                                "properties": {
                                    "information": { "type": "string", "enum": ["Healthy"] }
                                },
                                "required": ["information"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        }
    }
}
