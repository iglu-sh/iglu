{
    "responses": {
        "200": {
            "description": "Success response containing the tenants you were looking for",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean", "enum": [false] },
                            "data": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "string" },
                                        "github_username": { "type": "string" },
                                        "name": { "type": "string" },
                                        "permission": { "type": "string" },
                                        "is_public": { "type": "boolean" },
                                        "preferred_compression_method": { "type": "string" },
                                        "uri": { "type": "string" },
                                        "priority": { "type": "number" },
                                        "ttl": { "type": "number" }
                                    },
                                    "required": [
                                        "id",
                                        "github_username",
                                        "name",
                                        "permission",
                                        "is_public",
                                        "preferred_compression_method",
                                        "uri",
                                        "priority",
                                        "ttl"
                                    ]
                                }
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "400": {
            "description": "Returned if you did not provide the ?query= param",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "401": {
            "description": "Returned if either your auth header was malformed OR the api key provided does not exist",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "403": {
            "description": "Returned if you did not provide an auth header",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        },
        "503": {
            "description": "Returned if the feature this route is part of is not enabled",
            "content": {
                "application/json": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status_code": { "type": "number" },
                            "status_message": { "type": "string" },
                            "is_error": { "type": "boolean" },
                            "data": {
                                "type": "object",
                                "properties": { "error_details": { "type": "string" } },
                                "required": ["error_details"]
                            },
                            "timestamp": { "type": "number" }
                        },
                        "required": [
                            "status_code",
                            "status_message",
                            "is_error",
                            "data",
                            "timestamp"
                        ]
                    }
                }
            }
        }
    }
}
